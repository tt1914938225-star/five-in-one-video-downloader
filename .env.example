# Required. Generate a fresh random key; do not use a test fixture value.
MEDIA_TOKEN_SECRET=
# Optional existing provider protocol: GET /igdl|ttdl|twitter|douyin|rednote?url=...
PARSER_BASE_URL=https://backend1.tioo.eu.org
# Optional versioned adapter protocol, overrides PARSER_BASE_URL. See docs/OPERATIONS.md.
PARSER_ADAPTER_URL=
# Optional bearer credential, sent only server-to-server to the configured parser.
PARSER_API_KEY=
# Optional exact media/redirect hostnames approved by the operator, comma separated.
MEDIA_ALLOWED_HOSTS=
